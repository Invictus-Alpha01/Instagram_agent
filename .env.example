# Copy this file to .env and replace every placeholder before a live run.
# python -m insta_agent check

# --- OpenRouter (analyst, creator, visual check, and photographs) ---
# One key covers chat, vision, and image generation. Model ids are OpenRouter slugs.
OPENROUTER_API_KEY=placeholder-openrouter-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
TEXT_MODEL=openai/gpt-4o-mini
VISION_MODEL=openai/gpt-4o
# Any model on the OpenRouter Image API. Photographs are 4:5 so they crop to 1080x1350.
IMAGE_MODEL=black-forest-labs/flux.2-pro
IMAGE_ASPECT_RATIO=4:5
IMAGE_RESOLUTION=1K
# Optional integer. Each slide uses this seed plus its index.
# IMAGE_SEED=

# --- Instagram Graph API (the professional account you own) ---
INSTAGRAM_ACCESS_TOKEN=placeholder-instagram-token
INSTAGRAM_ACCOUNT_ID=placeholder-instagram-account-id
# Facebook Login uses graph.facebook.com. Instagram Login uses graph.instagram.com.
GRAPH_API_BASE=https://graph.facebook.com/v27.0

# --- Account voice ---
BRAND_NAME=Your Brand
BRAND_VOICE=clear, specific, and warm
ACCENT_COLOR=#111111
# Required. Say what this account actually posts about.
ACCOUNT_NICHE=placeholder-describe-the-account-niche

# --- Schedule and shape ---
CAROUSEL_SLIDES=5
POST_INTERVAL_HOURS=24
# true keeps runs local: generate and visually check, do not upload or publish.
POST_DRY_RUN=true
MAX_QA_RETRIES=2

# Where Instagram fetches the finished JPEGs from.
# catbox needs no extra key. public_dir uses a folder you already serve over HTTPS.
IMAGE_HOST=catbox
# IMAGE_PUBLIC_DIR=C:\path\to\public\instagram
# IMAGE_PUBLIC_BASE_URL=https://cdn.example.com/instagram
